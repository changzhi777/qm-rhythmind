# ── 必填（生产环境）─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
JWT_SECRET=change-me-to-random-256bit-string
LITELLM_MASTER_KEY=sk-...

# ── 数据库（PostgreSQL，docker-compose 默认）────────────────────────────
DATABASE_URL=postgresql+asyncpg://rhythmind:rhythmind@postgres:5432/rhythmind

# PostgreSQL 连接池（生产可适当调大）
PG_POOL_SIZE=10
PG_POOL_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=30
PG_POOL_RECYCLE=1800

# 单元测试专用（pytest conftest 自动注入，无需手动设置）
# DATABASE_URL=sqlite+aiosqlite:///:memory:

# ── 中间件 ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=dev-token-change-me
INFLUXDB_ORG=rhythmind
INFLUXDB_BUCKET=health_metrics

# ── 服务地址 ─────────────────────────────────────────────────────────────
QMD_URL=http://qmd:8181
LITELLM_URL=http://litellm:4000

# ── 合规阈值（通常不需要修改）────────────────────────────────────────────
COMPLIANCE_PASS_THRESHOLD=0.75
COMPLIANCE_WARN_THRESHOLD=0.50
LOOP_GUARD_TTL_HOURS=24
LOOP_GUARD_MAX_CALLS=3

# ── 可选：Sentry 错误追踪 ─────────────────────────────────────────────────
SENTRY_DSN=

# ── 环境标识 ─────────────────────────────────────────────────────────────
ENV=dev
DEBUG=false
