# ── 必填（生产环境）─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-...
# JWT_SECRET 至少 32 字符。生成：openssl rand -hex 32
# 若 ENV=prod 时使用以下任一默认值，启动会被 assert_production_safe 拒绝：
#   change-me-in-prod / change-me-to-random-256bit-string / dev-secret-change-in-prod
JWT_SECRET=change-me-to-random-256bit-string
LITELLM_MASTER_KEY=sk-...

# ── 鉴权 / CORS / 启动行为 ────────────────────────────────────────────────
# 生产必须为 false；本地若要以明文 Bearer 传 user_id 调试，临时改为 true。
DEV_AUTH_BYPASS=false
# 跨域白名单（逗号分隔）；生产留空 = 拒绝所有跨域。
CORS_ALLOW_ORIGINS=https://app.rhythmind.ai
# 容器启动时自动跑 alembic upgrade head（K8s 部署推荐 true）。
RUN_MIGRATIONS_ON_STARTUP=false
# 启动时校验 model_primary_spec 与平台一致（mlx:// 必须在 Apple Silicon）。
ENFORCE_MODEL_PLATFORM=true
# 生产模型推荐使用 Ollama 或 LiteLLM，因 MLX 仅支持 Apple Silicon。
# MODEL_PRIMARY_SPEC=ollama://qwen2.5:7b
# MCP 端点（/mcp/sse, /mcp/messages/）是否要求 Bearer JWT。
# 生产强制 true（assert_production_safe 拒绝 false）；本地受信任环境可临时 false。
MCP_REQUIRE_AUTH=true
# 请求体硬上限（字节）。0 表示禁用（不推荐）。
MAX_REQUEST_BODY_BYTES=1048576

# ── 数据库（PostgreSQL，docker-compose 默认）────────────────────────────
DATABASE_URL=postgresql+asyncpg://rhythmind:rhythmind@postgres:5432/rhythmind

# PostgreSQL 连接池（生产可适当调大）
PG_POOL_SIZE=10
PG_POOL_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=30
PG_POOL_RECYCLE=1800

# 单元测试专用（pytest conftest 自动注入，无需手动设置）
# DATABASE_URL=sqlite+aiosqlite:///:memory:

# ── 中间件 ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=dev-token-change-me
INFLUXDB_ORG=rhythmind
INFLUXDB_BUCKET=health_metrics

# ── 服务地址 ─────────────────────────────────────────────────────────────
QMD_URL=http://qmd:8181
LITELLM_URL=http://litellm:4000

# ── oMLX 算力 API（本地/远程 LLM 推理服务，OpenAI 兼容接口）───────────────
# 主力推理模型地址：Qwen3.6-27B-4bit 等通过此地址调用
OMLX_BASE_URL=http://10.10.10.35:8000
OMLX_API_KEY=change-me
# 合规审查专用实例（可与主实例相同，或独立部署避免争抢资源）
# 留空 = 复用 OMLX_BASE_URL
OMLX_COMPLIANCE_BASE_URL=
# 健康检查超时（秒）
OMLX_CHAT_TIMEOUT=60

# ── 合规阈值（通常不需要修改）────────────────────────────────────────────
COMPLIANCE_PASS_THRESHOLD=0.75
COMPLIANCE_WARN_THRESHOLD=0.50
LOOP_GUARD_TTL_HOURS=24
LOOP_GUARD_MAX_CALLS=3

# ── 可选：Sentry 错误追踪 ─────────────────────────────────────────────────
SENTRY_DSN=

# ── 环境标识 ─────────────────────────────────────────────────────────────
ENV=dev
DEBUG=false
